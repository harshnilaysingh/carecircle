NODE_ENV=development
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=false
DATABASE_URL=postgresql://carecircle:change-me@localhost:5432/carecircle?schema=public
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=
EMAIL_FROM=care@example.com
# PayPal sandbox only. Create a REST app in the PayPal Developer Dashboard.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=
PAYPAL_FAMILY_BASE_AMOUNT=
PAYPAL_EXTRA_SEAT_AMOUNT=
# The public API origin used for PayPal return/cancel callbacks.
API_PUBLIC_URL=
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=cc_session
SESSION_TTL_DAYS=14
# Generate a unique 32+ character random value per environment. Never commit a real value.
SESSION_HASH_KEY=replace-with-random-secret-at-least-32-characters
INVITATION_HASH_KEY=replace-with-a-different-random-secret-at-least-32-characters
# UI base URL.
PUBLIC_APP_URL=http://localhost:5173
