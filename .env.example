NODE_ENV=development
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=false
DATABASE_URL=postgresql://carecircle:change-me@localhost:5432/carecircle?schema=public
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=
EMAIL_FROM=care@example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_PRICE_ID=price_replace_with_family_base_price
STRIPE_EXTRA_SEAT_PRICE_ID=price_replace_with_extra_seat_price
# Optional overrides. Defaults point to the configured PUBLIC_APP_URL.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=cc_session
SESSION_TTL_DAYS=14
# Generate a unique 32+ character random value per environment. Never commit a real value.
SESSION_HASH_KEY=replace-with-random-secret-at-least-32-characters
INVITATION_HASH_KEY=replace-with-a-different-random-secret-at-least-32-characters
# Required in production. Set to an HTTPS origin; cookies use Secure outside development.
PUBLIC_APP_URL=http://localhost:5173
